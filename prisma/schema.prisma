generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MexicanNnp {
  id                   Int      @id @default(autoincrement())
  numeracion_inicial   BigInt
  numeracion_final     BigInt
  modalidad            String?
  raw                  Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([numeracion_inicial, numeracion_final])
  @@index([numeracion_inicial, numeracion_final])
}
